# Copy to frontend/.env and fill in your values

# Mapbox token — OPTIONAL.
# By default the app fetches the public token at runtime from the backend
# (GET /api/config/mapbox-token, sourced from backend/.env → MAPBOX_TOKEN),
# so nothing needs to be set here and the token stays out of the built bundle.
# Only set this to PIN a build-time token for static hosting without the API:
# VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Supabase (optional — operator realtime + get-mapbox-token edge function)
# Leave unset to use API polling only; the app will not crash without these.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
