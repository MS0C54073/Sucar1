# Copy to frontend/.env and fill in your values

# Mapbox (required for maps, geocoding, turn-by-turn directions)
# Get a token: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Supabase (optional — enables get-mapbox-token edge function)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
