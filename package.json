{
  "name": "sucar",
  "version": "1.0.0",
  "description": "SuCAR - Car Wash Pickup Booking System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "mobile": "cd mobile && npm run start",
    "mobile:client": "cd mobile && npm run android:client",
    "mobile:driver": "cd mobile && npm run android:driver",
    "mobile:start": "cd mobile && npm run start",
    "mobile:start:driver": "cd mobile && npm run start:driver",
    "android:client": "cd mobile && npm run android:client",
    "android:driver": "cd mobile && npm run android:driver",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "build": "cd frontend && npm run build && cd ../backend && npm run build",
    "start:frontend": "cd frontend && npm run preview",
    "start:backend": "cd backend && npm start"
  },
  "keywords": [
    "car-wash",
    "booking",
    "pickup"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
