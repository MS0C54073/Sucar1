# Copy to mobile/.env and fill in your values (mobile/.env is gitignored).
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app at build time.

# Google sign-in — OPTIONAL.
# The "Continue with Google" button stays inactive until at least the Web
# client id is set. Create these in Google Cloud Console (see
# GOOGLE_AUTH_SETUP.md):
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID     — "Web application" client. Required.
#                                          Used in Expo Go and as the token
#                                          audience the backend verifies.
#   EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID — "Android" client. Needed for a
#                                          standalone Android build.
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID     — "iOS" client. Needed for a
#                                          standalone iOS build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Backend API override — OPTIONAL.
# When unset, the app auto-detects the host from the Expo dev server (physical
# device) or falls back to the Android emulator address (10.0.2.2:5000).
# API_URL=http://192.168.1.50:5000
