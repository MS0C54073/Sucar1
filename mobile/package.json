{
  "name": "sucar-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "cross-env APP_VARIANT=client npx expo start",
    "start:clear": "cross-env APP_VARIANT=client npx expo start -c",
    "start:client": "cross-env APP_VARIANT=client npx expo start",
    "start:driver": "cross-env APP_VARIANT=driver npx expo start",
    "android": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1 -Variant client",
    "android:client": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1 -Variant client",
    "android:driver": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1 -Variant driver",
    "andriod": "cross-env APP_VARIANT=client npx expo start --android",
    "android:port": "cross-env APP_VARIANT=client npx expo start --android --port 8082",
    "ios": "cross-env APP_VARIANT=client npx expo start --ios",
    "ios:client": "cross-env APP_VARIANT=client npx expo start --ios",
    "ios:driver": "cross-env APP_VARIANT=driver npx expo start --ios",
    "web": "npx expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.18.0",
    "@react-navigation/drawer": "^7.12.0",
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "axios": "^1.6.2",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-animatable": "^1.3.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.0.2",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^7.0.3",
    "react-native-worklets": "0.5.1",
    "typescript": "^5.1.3"
  },
  "private": true
}
