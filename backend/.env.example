# Copy to backend/.env and fill in your values (backend/.env is gitignored)

PORT=5000
NODE_ENV=development

# Auth — REQUIRED. Must be a strong random string (>=16 chars); server fails fast in production without it.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=7d

# Supabase
SUPABASE_URL=http://127.0.0.1:54325
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct Postgres connection (used by migrate:all and auto-migrations)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54323/postgres

# Mapbox PUBLIC token (pk.*). Served to the client at runtime via
# GET /api/config/mapbox-token so it is never committed or baked into the
# frontend bundle. Restrict it by URL in the Mapbox dashboard.
MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Google sign-in — OPTIONAL. Enables POST /auth/google.
# The backend verifies the Google ID token's audience against these client IDs,
# so list every client that may send a token:
#   GOOGLE_CLIENT_ID         — the "Web application" OAuth client (also used by
#                              the web app as VITE_GOOGLE_CLIENT_ID).
#   GOOGLE_ANDROID_CLIENT_ID — the "Android" OAuth client (mobile, optional).
#   GOOGLE_IOS_CLIENT_ID     — the "iOS" OAuth client (mobile, optional).
# Leave unset to keep Google sign-in disabled. See GOOGLE_AUTH_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
